{
  "name": "lectern",
  "version": "0.0.1",
  "private": true,
  "description": "A reading application for a personal library, built around reading aloud",
  "author": "Liam Grant",
  "license": "UNLICENSED",
  "scripts": {
    "convert": "node scripts/html-to-markdown.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-html-parser": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.3",
    "mathjax": "^3.2.2",
    "pdfjs-dist": "^6.2.108",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sherpa-onnx-node": "^1.13.6",
    "speech-rule-engine": "^5.0.0-rc.4",
    "temml": "^0.13.4",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "main": "./out/main/index.js"
}
